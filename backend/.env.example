# Application
APP_NAME="German Vocabulary Trainer API"
ENVIRONMENT=local
DEBUG=true
API_PREFIX=/api

# Database (matches docker-compose.yml)
DATABASE_URL=postgresql+psycopg://vocab:vocab@127.0.0.1:5432/vocab
DATABASE_ECHO=false

# File uploads (relative paths are resolved against the backend/ directory)
UPLOAD_DIR=uploads
MAX_UPLOAD_SIZE_MB=20

# Built frontend served by the backend (set by start.ps1; leave empty during development)
# FRONTEND_DIST_DIR=../frontend/dist

# Login sessions (cookie). SESSION_COOKIE_SECURE=true needs HTTPS (production).
SESSION_COOKIE_SECURE=false
SESSION_DAYS=30

# AI. Every user picks the provider, model and API key on the settings page (/settings).
AI_MAX_PAGES_PER_REQUEST=5
AI_MAX_CONCURRENCY=4
# Requests per minute per Gemini model; Gemini's free tier allows 5.
AI_REQUESTS_PER_MINUTE=60
AI_REQUEST_TIMEOUT_SECONDS=180
AI_MAX_OUTPUT_TOKENS=16000

# Encrypts the users' API keys in the database. Required in production (keep it stable);
# locally a development default is used when empty. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=
