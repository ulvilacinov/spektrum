# Application
APP_NAME="German Vocabulary Trainer API"
ENVIRONMENT=local
DEBUG=true
API_PREFIX=/api

# Database (matches docker-compose.yml)
DATABASE_URL=postgresql+psycopg://vocab:vocab@localhost:5432/vocab
DATABASE_ECHO=false

# File uploads (relative paths are resolved against the backend/ directory)
UPLOAD_DIR=uploads
MAX_UPLOAD_SIZE_MB=20

# AI (document analysis)
AI_PROVIDER=gemini
AI_MAX_PAGES_PER_REQUEST=5
AI_MAX_CONCURRENCY=4
# Requests per minute per model; Gemini's free tier allows 5.
AI_REQUESTS_PER_MINUTE=5
AI_REQUEST_TIMEOUT_SECONDS=180
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
